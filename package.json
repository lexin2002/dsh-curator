{
  "name": "dsh-curator",
  "version": "0.1.0",
  "description": "DSH 控制台：一处管理本机所有 coding agent 的技能与 DSH 插件，内置技能市场与插件市场，并用 AI 把每个技能/插件讲成中文说明。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "skill",
    "skills",
    "skill-management",
    "plugin-management",
    "agent-skills"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexin2002/dsh-curator.git"
  },
  "homepage": "https://github.com/lexin2002/dsh-curator#readme",
  "bugs": {
    "url": "https://github.com/lexin2002/dsh-curator/issues"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
